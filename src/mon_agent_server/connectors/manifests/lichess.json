{
  "schemaVersion": 1,
  "key": "lichess",
  "name": "Lichess",
  "description": "接收挑战与棋局事件，并在 Lichess Bot API 上执行走棋和对局操作。",
  "icon": "cable",
  "version": "1",
  "adapter": "mon_agent_server.connectors.lichess:LichessConnector",
  "executeRequiresStream": false,
  "watch": ["lichess.py"],
  "events": {
    "challenge": {
      "title": "接收挑战",
      "description": "接收并处理新的 Lichess 对局挑战。"
    },
    "game_state": {
      "title": "棋局状态",
      "description": "接收走棋、时钟、轮次与终局状态事件。"
    }
  },
  "queries": {},
  "actions": {
    "accept_challenge": {
      "type": "object",
      "title": "接受挑战",
      "description": "接受指定的 Lichess 挑战。",
      "properties": {
        "challenge_id": {"type": "string", "minLength": 1, "description": "挑战 ID。"}
      },
      "required": ["challenge_id"],
      "additionalProperties": false
    },
    "decline_challenge": {
      "type": "object",
      "title": "拒绝挑战",
      "description": "使用 Lichess 原因代码拒绝指定挑战。",
      "properties": {
        "challenge_id": {"type": "string", "minLength": 1, "description": "挑战 ID。"},
        "reason": {
          "type": "string",
          "description": "拒绝原因代码。",
          "enum": ["generic", "later", "tooFast", "tooSlow", "timeControl", "rated", "casual", "standard", "variant", "noBot", "onlyBot"]
        }
      },
      "required": ["challenge_id"],
      "additionalProperties": false
    },
    "make_move": {
      "type": "object",
      "title": "执行走棋",
      "description": "在指定棋局提交一步 UCI 格式的合法着法。",
      "properties": {
        "game_id": {"type": "string", "minLength": 1, "description": "棋局 ID。"},
        "move": {"type": "string", "minLength": 1, "description": "UCI 格式着法，例如 e2e4。"},
        "offer_draw": {"type": "boolean", "description": "走棋时同时提和。"}
      },
      "required": ["game_id", "move"],
      "additionalProperties": false
    },
    "resign": {
      "type": "object",
      "title": "认输",
      "description": "在指定棋局认输。",
      "properties": {
        "game_id": {"type": "string", "minLength": 1, "description": "棋局 ID。"}
      },
      "required": ["game_id"],
      "additionalProperties": false
    },
    "offer_draw": {
      "type": "object",
      "title": "提出和棋",
      "description": "在指定棋局提出和棋。",
      "properties": {
        "game_id": {"type": "string", "minLength": 1, "description": "棋局 ID。"}
      },
      "required": ["game_id"],
      "additionalProperties": false
    },
    "send_chat": {
      "type": "object",
      "title": "发送棋局消息",
      "description": "向指定 Lichess 棋局聊天室发送消息。",
      "properties": {
        "game_id": {"type": "string", "minLength": 1, "description": "棋局 ID。"},
        "text": {"type": "string", "minLength": 1, "description": "消息内容。"},
        "room": {"type": "string", "enum": ["player", "spectator"], "description": "聊天室，默认 player。"}
      },
      "required": ["game_id", "text"],
      "additionalProperties": false
    }
  }
}
