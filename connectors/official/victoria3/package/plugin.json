{
  "schemaVersion": 1,
  "id": "official.victoria3",
  "name": "Victoria 3 Bridge",
  "description": "Official isolated Worker plugin for Victoria 3 observation and the opt-in control probe.",
  "version": "2.0.0",
  "components": {
    "runtimes": [
      {
        "id": "victoria3",
        "kind": "connector",
        "manifest": "connector.json",
        "enabledByDefault": true
      }
    ]
  },
  "permissions": [
    {
      "capability": "filesystem.read",
      "resource": "settings.logPath",
      "access": "read",
      "required": true,
      "description": "读取用户选择的 Victoria 3 debug.log。"
    },
    {
      "capability": "filesystem.write",
      "resource": "settings.commandDirectory",
      "access": "write",
      "required": false,
      "description": "仅在显式启用控制探针时写入临时 run 命令。"
    },
    {
      "capability": "desktop.input",
      "resource": "application:victoria3",
      "access": "control",
      "required": false,
      "description": "向 Victoria 3 前台窗口注入控制探针；要求支持 Windows 桌面输入隔离的宿主，当前 Linux 宿主不可启用。"
    }
  ],
  "assets": [
    {
      "source": "assets/game-mod",
      "targetKind": "paradox-user-mod",
      "target": "Victoria 3/mod/edenagent_victoria3_observer"
    }
  ]
}
