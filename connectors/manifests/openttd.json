{
  "schemaVersion": 1,
  "key": "openttd",
  "name": "本地 OpenTTD",
  "description": "Rust Server 直连 OpenTTD Admin Port，并通过 MonAgentBridge 执行结构化操作。",
  "icon": "gamepad",
  "version": "9",
  "runtime": "rust-native-admin-port",
  "settingsSchema": {
    "type": "object",
    "properties": {
      "host": { "type": "string", "minLength": 1, "maxLength": 253 },
      "adminPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
      "gamePort": { "type": "integer", "minimum": 1, "maximum": 65535 },
      "passwordEnv": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
      "instanceRegistry": { "type": "string", "minLength": 1, "maxLength": 4096 },
      "selfAwakeOnEvent": { "type": "boolean" },
      "boundSessionId": { "type": "string", "format": "uuid" }
    },
    "additionalProperties": false
  },
  "events": {
    "chat": { "title": "游戏聊天", "description": "监听服务器中的聊天消息。" },
    "new_game": { "title": "新游戏事件", "description": "接收新游戏开始与地图重载事件。" },
    "company_removed": { "title": "公司状态事件", "description": "接收公司移除等生命周期事件。" },
    "gamescript": { "title": "桥接脚本事件", "description": "接收结构化命令结果与游戏状态。" }
  },
  "queries": {
    "get_state": {
      "type": "object", "title": "查询游戏状态", "description": "读取服务器、公司与经济摘要。",
      "x-monagent-invocation": { "tool": "query_openttd", "query": "get_state" },
      "properties": {}, "additionalProperties": false
    },
    "inspect_tile": {
      "type": "object", "title": "检查地图格", "description": "读取指定坐标的地形与占用信息。",
      "x-monagent-invocation": { "tool": "query_openttd", "query": "inspect_tile" },
      "properties": { "x": { "type": "integer" }, "y": { "type": "integer" } },
      "required": ["x", "y"], "additionalProperties": false
    },
    "find_towns": {
      "type": "object", "title": "查找城镇", "description": "按位置查找附近城镇。",
      "x-monagent-invocation": { "tool": "query_openttd", "query": "find_towns" },
      "properties": { "x": { "type": "integer" }, "y": { "type": "integer" }, "limit": { "type": "integer", "minimum": 1, "maximum": 100 } },
      "additionalProperties": false
    },
    "find_industries": {
      "type": "object", "title": "查找产业", "description": "按位置查找产业。",
      "x-monagent-invocation": { "tool": "query_openttd", "query": "find_industries" },
      "properties": { "x": { "type": "integer" }, "y": { "type": "integer" }, "limit": { "type": "integer", "minimum": 1, "maximum": 100 } },
      "additionalProperties": false
    },
    "get_company_assets": {
      "type": "object", "title": "查询公司资产", "description": "读取公司的车辆与基础设施摘要。",
      "x-monagent-invocation": { "tool": "query_openttd", "query": "get_company_assets" },
      "properties": { "company_id": { "type": "integer", "minimum": 0, "maximum": 255 } },
      "required": ["company_id"], "additionalProperties": false
    },
    "list_road_engines": {
      "type": "object", "title": "查询公路车型", "description": "读取可购买的公路车辆。",
      "x-monagent-invocation": { "tool": "query_openttd", "query": "list_road_engines" },
      "properties": { "company_id": { "type": "integer", "minimum": 0, "maximum": 255 } },
      "required": ["company_id"], "additionalProperties": false
    },
    "find_road_route_site": {
      "type": "object", "title": "规划公路站点", "description": "查找适合公路线与站点的地图格。",
      "x-monagent-invocation": { "tool": "query_openttd", "query": "find_road_route_site" },
      "properties": {
        "x": { "type": "integer" }, "y": { "type": "integer" },
        "length": { "type": "integer", "minimum": 1, "maximum": 256 }
      },
      "additionalProperties": false
    }
  },
  "actions": {
    "refresh_state": { "type": "object", "title": "刷新状态", "description": "立即读取完整状态。", "properties": {}, "additionalProperties": false },
    "pause_game": { "type": "object", "title": "暂停游戏", "description": "暂停当前游戏。", "properties": {}, "additionalProperties": false },
    "resume_game": { "type": "object", "title": "继续游戏", "description": "继续当前游戏。", "properties": {}, "additionalProperties": false },
    "save_game": {
      "type": "object", "title": "保存游戏", "description": "保存当前游戏。",
      "properties": { "save_name": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9._-]+$" } },
      "additionalProperties": false
    },
    "send_chat": {
      "type": "object", "title": "发送聊天", "description": "向服务器发送聊天消息。",
      "properties": { "text": { "type": "string", "minLength": 1, "maxLength": 4096 } },
      "required": ["text"], "additionalProperties": false
    },
    "gameplay_command": {
      "type": "object", "title": "执行游戏操作", "description": "执行一条结构化玩法命令。",
      "properties": {
        "command": {
          "type": "object",
          "properties": { "action": { "type": "string", "minLength": 1, "maxLength": 128 } },
          "required": ["action"], "additionalProperties": true
        }
      },
      "required": ["command"], "additionalProperties": false
    },
    "gameplay_plan": {
      "type": "object", "title": "执行玩法计划", "description": "顺序执行结构化命令。",
      "properties": {
        "commands": {
          "type": "array", "minItems": 1, "maxItems": 50,
          "items": {
            "type": "object",
            "properties": { "action": { "type": "string", "minLength": 1, "maxLength": 128 } },
            "required": ["action"], "additionalProperties": true
          }
        }
      },
      "required": ["commands"], "additionalProperties": false
    }
  }
}
